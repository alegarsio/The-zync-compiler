pkg main

import std
import @c raylib.h

fn main() -> void {
    InitWindow(800, 450, "Zync Direct Raylib".c_str());
    SetTargetFPS(60);

    for {
        if (WindowShouldClose()) {
            break;
        }

        BeginDrawing();
        ClearBackground(RAYWHITE);
        DrawText("Hello world!".c_str(), 200, 200, 22, DARKGRAY);
        EndDrawing();
    }

    CloseWindow();
}